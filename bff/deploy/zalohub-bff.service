[Unit]
Description=ZaloHub BFF (Backend For Frontend)
After=network.target postgresql.service

[Service]
Type=simple
User=leco
WorkingDirectory=/home/leco/zalohub/bff
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=3
Environment=NODE_ENV=production
Environment=BFF_PORT=3401
Environment=BACKEND_URL=http://localhost:3399
Environment=JWT_SECRET=zalohub-dev-secret-change-in-production
StandardOutput=append:/tmp/zalohub-bff.log
StandardError=append:/tmp/zalohub-bff.log

[Install]
WantedBy=multi-user.target
