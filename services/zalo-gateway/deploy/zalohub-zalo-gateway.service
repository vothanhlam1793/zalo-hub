[Unit]
Description=ZaloHub Zalo Gateway
After=network.target docker.service

[Service]
Type=simple
User=leco
WorkingDirectory=/home/leco/zalohub
EnvironmentFile=/etc/zalohub/zalo-gateway.env
ExecStart=/home/leco/.nvm/versions/node/v22.22.2/bin/node services/zalo-gateway/dist/index.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
